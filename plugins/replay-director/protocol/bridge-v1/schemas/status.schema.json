{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://replay-mcp.local/schemas/bridge-v1/status.schema.json",
  "title": "Replay MCP hello and status result",
  "type": "object",
  "additionalProperties": true,
  "required": ["runtime_mode", "capabilities", "lease", "lease_policy", "command_policy", "flight_policy", "allowed_artifact_roots"],
  "properties": {
    "protocol": {"const": "replay-mcp.bridge/1"},
    "instance_id": {"type": "string", "format": "uuid"},
    "process_id": {"type": "integer", "minimum": 1},
    "runtime_mode": {"enum": ["game_offline", "live_idle", "live_recording", "replay_loading", "replay_loaded", "rendering"]},
    "capabilities": {"type": "object"},
    "lease": {
      "type": "object",
      "required": ["held", "epoch"],
      "properties": {
        "held": {"type": "boolean"},
        "epoch": {"type": "integer", "minimum": 0},
        "owner_label": {"type": "string"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "lease_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ttl_ms", "heartbeat_interval_ms", "idle_ceiling_ms"],
      "properties": {
        "ttl_ms": {"type": "integer", "minimum": 5000},
        "heartbeat_interval_ms": {"type": "integer", "minimum": 1000},
        "idle_ceiling_ms": {"type": "integer", "minimum": 5000}
      }
    },
    "command_policy": {
      "type": "object",
      "required": ["enabled", "locally_managed"],
      "properties": {
        "enabled": {"type": "boolean"},
        "locally_managed": {"type": "boolean"},
        "deny_pattern_count": {"type": "integer", "minimum": 0}
      }
    },
    "flight_policy": {
      "type": "object",
      "required": ["automation_enabled", "requires_granted_ability", "currently_granted"],
      "properties": {
        "automation_enabled": {"type": "boolean"},
        "requires_granted_ability": {"type": "boolean"},
        "currently_granted": {"type": "boolean"}
      }
    },
    "allowed_artifact_roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
