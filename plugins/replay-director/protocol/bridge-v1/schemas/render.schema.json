{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://replay-mcp.local/schemas/bridge-v1/render.schema.json",
  "title": "Replay MCP render job result or event",
  "type": "object",
  "additionalProperties": true,
  "required": ["job_id", "status"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["queued", "running", "completed", "failed", "cancelled"]},
    "progress": {"type": "number", "minimum": 0, "maximum": 1},
    "frames_done": {"type": "integer", "minimum": 0},
    "total_frames": {"type": "integer", "minimum": 0},
    "complete": {"type": "boolean"},
    "start_us": {"type": "integer", "minimum": 0},
    "end_us": {"type": "integer", "minimum": 1},
    "artifact": {"$ref": "artifact.schema.json"},
    "error": {"type": "string"}
  }
}
