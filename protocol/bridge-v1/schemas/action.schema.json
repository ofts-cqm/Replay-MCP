{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://replay-mcp.local/schemas/bridge-v1/action.schema.json",
  "title": "Replay MCP action batch",
  "type": "object",
  "additionalProperties": true,
  "required": ["request_id", "actions"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["kind"],
        "properties": {
          "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "timeout_ms": {"type": "integer", "minimum": 1},
          "label": {"type": "string", "maxLength": 256}
        },
        "allOf": [
          {
            "if": {
              "properties": {"kind": {"const": "navigate_to"}},
              "required": ["kind"]
            },
            "then": {
              "required": ["x", "y", "z"],
              "properties": {
                "x": {"type": "number"},
                "y": {"type": "number"},
                "z": {"type": "number"},
                "tolerance": {"type": "number", "minimum": 0.25, "maximum": 4.0},
                "sprint": {"type": "boolean"}
              }
            }
          }
        ]
      }
    },
    "on_failure": {"enum": ["stop", "continue"]},
    "capture": {"enum": ["none", "after", "checkpoints", "after_and_on_failure"]},
    "lease_id": {"type": "string", "minLength": 32},
    "fence": {"type": "integer", "minimum": 1}
  }
}
