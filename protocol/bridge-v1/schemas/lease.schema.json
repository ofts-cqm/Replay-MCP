{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://replay-mcp.local/schemas/bridge-v1/lease.schema.json",
  "title": "Replay MCP director lease",
  "type": "object",
  "additionalProperties": true,
  "required": ["lease_id", "fence", "owner_label", "expires_at"],
  "properties": {
    "lease_id": {"type": "string", "minLength": 32},
    "fence": {"type": "integer", "minimum": 1},
    "owner_label": {"type": "string", "minLength": 1, "maxLength": 64},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
